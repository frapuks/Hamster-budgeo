# Copier en `.env`, puis remplacer les `change-me`.
#
# Un seul fichier couvre les deux usages. Docker Compose ne lit ce fichier que pour
# substituer les variables du fichier compose : il ne l'injecte pas dans les conteneurs,
# donc le bloc « développement » reste sans effet sur la pile conteneurisée.

# ── Pile complète : `docker compose up -d` ───────────────────────────────────

APP_PORT=6011
POSTGRES_USER=hamster
POSTGRES_DB=hamsterbudgeo

# ⚠️ À définir AVANT le tout premier démarrage. PostgreSQL fige le mot de passe à
# l'initialisation du volume : le changer ensuite n'a aucun effet sur la base existante,
# et l'application ne pourra plus s'y connecter.
POSTGRES_PASSWORD=change-me

# `true` seulement si l'application est servie en HTTPS : le cookie de session devient
# alors `secure`, ce qui empêcherait toute connexion en HTTP.
HTTPS=false

# ── Développement local : `npm run db:up` puis `npm run dev` ──────────────────
# Inutile sur le Raspberry Pi. Le serveur Node tourne hors conteneur et joint la base
# par le port publié ci-dessous.

POSTGRES_PORT=5433
DATABASE_URL=postgres://hamster:change-me@localhost:5433/hamsterbudgeo
SERVER_PORT=3001
